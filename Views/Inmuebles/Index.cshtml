@model IEnumerable<PC2.Models.Inmueble>

@{
    ViewData["Title"] = "Catálogo de Inmuebles";
    var totalPages = (int)Math.Ceiling((double)(ViewBag.TotalItems ?? 0) / (int)(ViewBag.PageSize ?? 5));
    var currentPage = (int)(ViewBag.Page ?? 1);
}

<h1>Catálogo de Inmuebles</h1>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<!-- Filtros -->
<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Ciudad</label>
        <input type="text" name="ciudad" value="@ViewData["Ciudad"]" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Tipo</label>
        <select name="tipo" class="form-select">
            <option value="">-- Seleccione --</option>
            <option value="Departamento" selected="@(ViewData["Tipo"]?.ToString() == "Departamento")">Departamento</option>
            <option value="Casa" selected="@(ViewData["Tipo"]?.ToString() == "Casa")">Casa</option>
            <option value="Oficina" selected="@(ViewData["Tipo"]?.ToString() == "Oficina")">Oficina</option>
            <option value="Local" selected="@(ViewData["Tipo"]?.ToString() == "Local")">Local</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Precio Min</label>
        <input type="number" step="0.01" name="precioMin" value="@ViewData["PrecioMin"]" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Precio Max</label>
        <input type="number" step="0.01" name="precioMax" value="@ViewData["PrecioMax"]" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Dormitorios</label>
        <input type="number" name="dormitorios" value="@ViewData["Dormitorios"]" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<!-- Listado -->
<div class="listings-grid">
    @foreach (var inmueble in Model)
    {
        <article class="property-card card shadow-sm">
            <div class="card-image-container">
                <img src="@inmueble.Imagen" alt="@inmueble.Titulo" class="card-img-top" />
            </div>
            <div class="card-body">
                <h5 class="card-title">@inmueble.Titulo</h5>
                <p class="fw-bold text-primary">@inmueble.Precio.ToString("C")</p>
                <p>@inmueble.Ciudad - @inmueble.Direccion</p>
                <p>@inmueble.MetrosCuadrados m² · @inmueble.Dormitorios Hab · @inmueble.Banos Baños</p>
                <a asp-action="Details" asp-route-id="@inmueble.Id" class="btn btn-outline-info">
                    Ver Detalles
                </a>
            </div>
        </article>
    }
</div>

<!-- Paginación -->
@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination mt-4">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-ciudad="@ViewData["Ciudad"]"
                       asp-route-tipo="@ViewData["Tipo"]"
                       asp-route-precioMin="@ViewData["PrecioMin"]"
                       asp-route-precioMax="@ViewData["PrecioMax"]"
                       asp-route-dormitorios="@ViewData["Dormitorios"]">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}

<style>
    .listings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }
    .property-card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }
</style>